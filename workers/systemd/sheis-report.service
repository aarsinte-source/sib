[Unit]
Description=SHEis Workers — report_settimanale (report lunedì 09:00)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=alkemia
WorkingDirectory=/home/alkemia/sheis-workers
EnvironmentFile=/home/alkemia/sheis-workers/.env
ExecStart=/usr/bin/python3 /home/alkemia/sheis-workers/report_settimanale.py
StandardOutput=journal
StandardError=journal
