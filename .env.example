# SHEis Workers — variabili d'ambiente
#
# Copia in `.env` e riempi. Il .env NON va mai committato (è in .gitignore).
#
# REGOLA: qui vivono i SEGRETI. In config/workers.json vivono le SCELTE
# (destinatari, mappe account). Se ti trovi a scrivere una chiave API dentro
# workers.json, ti sei perso.
#
# L'interruttore generale di sicurezza è UNO SOLO:
#   LIVE=1   → invii/pubblicazioni/generazioni VERE
#   (assente) → simulazione. È il default, e resta il default finché qualcuno
#               non lo cambia consapevolmente riga per riga di comando.

# ==================================================================== Supabase
# Stesso progetto di ~/alkemia-sheis-backend (copia i valori da lì, o lascia
# vuoto: supabase.py prova quel .env come fallback automaticamente, essendo
# lo STESSO cliente/progetto — non un altro).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF=

# ==================================================================== Zernio
# zernio.com → Settings → API Keys → Create API Key (formato sk_ + 64 hex).
ZERNIO_API_KEY=

# ==================================================================== SMTP (report)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ==================================================================== Telegram (report)
TELEGRAM_BOT_TOKEN=

# ==================================================================== Higgsfield (creative_worker)
# 1 credito = €0,033 (misurato). Sopra questa soglia in euro serve conferma
# esplicita prima di generare — vedi lib/higgsfield.py gate_costo().
SHEIS_CREATIVE_SOGLIA_EUR=2.00
# Path del binario CLI, se diverso da quello sul PATH.
HIGGSFIELD_CLI=higgsfield

# ==================================================================== ScrapeCreators / DataForSEO (analisi_mensile)
SCRAPECREATORS_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ==================================================================== Percorsi
# SQLite del motore outreach, letto in SOLA LETTURA da report_settimanale.py.
SHEIS_OUTREACH_DB=/Users/andreiarsinte/alkemia-sheis-outreach/data/outreach.db

# ==================================================================== Interruttore generale
# 1 = invii/pubblicazioni/generazioni VERE. Assente o diverso da "1" = simulazione.
LIVE=

# Solo per collaudo manuale della finestra oraria — MAI su un worker schedulato.
SHEIS_ALLOW_OUTSIDE_WINDOW=

# Solo per dimostrare in simulazione la gestione del tetto giornaliero Higgsfield
# senza spendere davvero — MAI in produzione.
SHEIS_SIMULA_TETTO=
